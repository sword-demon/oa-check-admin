# ============================================================
# OA Check Admin - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_password_here
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/oa_admin?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
